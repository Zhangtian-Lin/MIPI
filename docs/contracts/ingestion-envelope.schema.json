{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mipi.local/schemas/ingestion-envelope-v1.json",
  "title": "MIPI Ingestion Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "task_id", "idempotency_key", "source_id", "url", "crawled_at", "content_hash", "raw_object_uri"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 8},
    "source_id": {"type": "string", "pattern": "^SRC-"},
    "url": {"type": "string", "format": "uri"},
    "canonical_url": {"type": ["string", "null"], "format": "uri"},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "crawled_at": {"type": "string", "format": "date-time"},
    "content_hash": {"type": "string", "pattern": "^sha256:"},
    "raw_object_uri": {"type": "string", "minLength": 1},
    "language": {"type": ["string", "null"]},
    "collection_relevance": {"enum": ["high", "medium", "low", "unknown"]},
    "verification_hint": {"enum": ["F0", "F1", "F2", "F3", "F4", null]},
    "publication_status": {"enum": ["raw_only", "staged", "under_review", "quarantined"]},
    "review_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
